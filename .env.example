# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Vuma
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_COUNTRY=ZA

# ── Payments: set to "true" to simulate successful payments
# without real merchant credentials (recommended until you
# have live PayFast / Paynow accounts) ───────────────────
PAYMENTS_MOCK_MODE=true

# PayFast (South Africa) — https://www.payfast.co.za
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# Paynow (Zimbabwe, incl. EcoCash) — https://www.paynow.co.zw
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=

# ── Maps ──────────────────────────────────────────────────
# Leave blank to use free OpenStreetMap tiles + Nominatim geocoding.
# Add a Google Maps or Mapbox key later to upgrade (see README).
NEXT_PUBLIC_MAPBOX_TOKEN=

# Geocoding: Nominatim's public server aggressively IP-blocks many
# residential/shared networks with no warning (see README). Get a free key
# at locationiq.com (no card required) and paste it here to fix search
# reliably — same OpenStreetMap data, just without the blocking.
LOCATIONIQ_API_KEY=

# Best address/landmark/intersection search accuracy — Google's commercial
# map data is far more complete than OSM in many Southern African areas.
# Optional, but recommended once you're past testing (see README "Upgrading
# geocoding accuracy"). If set, takes priority over LocationIQ/Nominatim
# automatically, no other code changes needed.
GOOGLE_PLACES_API_KEY=
